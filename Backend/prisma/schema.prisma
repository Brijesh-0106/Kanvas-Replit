// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  refToken  String
  ip        String
  revoked   Boolean  @default(false)
  user      User     @relation(references: [id], fields: [userId])
  userId    String
  userAgent String
  createdAt DateTime @default(now()) // like createdAt in Mongoose
  updatedAt DateTime @updatedAt // auto-updates on every save
}

model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  password     String
  projects     Project[]
  maxProject   Int       @default(2)
  aiProjectCnt Int       @default(0)
  sessions     session[]
}

model File {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  project   Project  @relation(references: [id], fields: [projectId])
  projectId String
  path      String
  content   String
  createdAt DateTime @default(now()) // like createdAt in Mongoose
  updatedAt DateTime @updatedAt // auto-updates on every save
  embedding Float[]

  @@unique([projectId, path]) // Creates the compound index `projectId_path`
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  project   Project  @relation(references: [id], fields: [projectId])
  isAi      Boolean  @default(false)
  edited    Boolean  @default(false)
  replyTo   String?
  msg       String
  createdAt DateTime @default(now()) // like createdAt in Mongoose
  updatedAt DateTime @updatedAt // auto-updates on every save
  projectId String   @db.ObjectId
}

model Project {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String?
  projectName   String?
  projectType   String?
  ip            String
  isUsed        Boolean
  isStale       Boolean   @default(false)
  publicDnsName String
  assignedAt    DateTime?
  userId        String?
  s3Key         String
  instanceId    String
  user          User?     @relation(fields: [userId], references: [id])
  fileTree      Json      @default("{}")
  files         File[]
  messages      Message[]
}
